<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0A0A0A">
    <title>{{ shop.name }}</title>
    <meta name="robots" content="noindex, nofollow">

    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {{ content_for_header }}

    {%- style -%}
      :root{
        --color-bg: {{ settings.color_background }};
        --color-bg-secondary: {{ settings.color_background_secondary }};
        --color-dark-panel: {{ settings.color_dark_panel }};
        --color-text: {{ settings.color_text }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-secondary: {{ settings.color_accent_secondary }};
        --color-border: {{ settings.color_border }};
        --font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
        --font-heading-weight: {{ settings.font_heading.weight }};
        --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
        --font-body-weight: {{ settings.font_body.weight }};
      }
    {%- endstyle -%}

    {%- style -%}
      {{ settings.font_heading | font_face: font_display: 'swap' }}
      {{ settings.font_body | font_face: font_display: 'swap' }}
    {%- endstyle -%}

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <style>
      body.template-password {
        background: #0A0A0A;
        color: #ffffff;
        margin: 0;
        min-height: 100vh;
      }
      .password-page {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding: 3rem 1.5rem 2.5rem;
        text-align: center;
      }
      .password-page a { color: inherit; }
    </style>
  </head>
  <body class="template-password">
    <div class="password-page">
      {{ content_for_layout }}
    </div>
  </body>
</html>
