{%- if cart.item_count > 0 -%}
  <ul class="cart-items">
    {%- for item in cart.items -%}
      <li class="cart-item" data-cart-item data-line="{{ forloop.index }}">
        <a href="{{ item.url }}" class="cart-item__image">
          {%- if item.image -%}
            <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" width="100" height="{{ 100 | divided_by: item.image.aspect_ratio }}">
          {%- endif -%}
        </a>
        <div class="cart-item__details">
          <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
          {%- unless item.variant.title == 'Default Title' -%}
            <p class="cart-item__variant">{{ item.variant.title }}</p>
          {%- endunless -%}
          <div class="cart-item__price-row">
            <div class="cart-item__quantity">
              <button type="button" data-cart-qty-decrease aria-label="Decrease quantity">&minus;</button>
              <input type="number" min="0" value="{{ item.quantity }}" data-cart-qty-input aria-label="Quantity">
              <button type="button" data-cart-qty-increase aria-label="Increase quantity">&plus;</button>
            </div>
            <span class="cart-item__line-price">{{ item.final_line_price | money }}</span>
          </div>
        </div>
        <button type="button" class="cart-item__remove" data-cart-remove aria-label="Remove item">{% render 'icon' with 'close' %}</button>
      </li>
    {%- endfor -%}
  </ul>

  <div class="cart-drawer__footer">
    <div class="cart-drawer__subtotal">
      <span>Subtotal</span>
      <span>{{ cart.total_price | money }}</span>
    </div>
    <p class="cart-drawer__note">Shipping and taxes calculated at checkout.</p>
    <a href="{{ routes.cart_url }}" class="button button--secondary">View Cart</a>
    <a href="{{ routes.cart_url }}/checkout" class="button button--primary">Checkout</a>
  </div>
{%- else -%}
  <div class="cart-drawer__empty">
    <p>Your cart is empty.</p>
    <a href="{{ routes.all_products_collection_url }}" class="button button--secondary">Continue shopping</a>
  </div>
{%- endif -%}
