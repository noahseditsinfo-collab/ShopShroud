{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-blog-grid-header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-blog-grid-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.subtitle_spacing }}px 0;
    line-height: 1.2;
  }

  .ai-blog-grid-subtitle-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-blog-grid-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: {{ block.settings.pagination_spacing }}px;
  }

  .ai-blog-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .ai-blog-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .ai-blog-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background-color: {{ block.settings.image_placeholder_bg }};
  }

  .ai-blog-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-blog-card-image-wrapper-{{ ai_gen_id }} svg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-blog-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .ai-blog-card-date-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.date_size }}px;
    color: {{ block.settings.date_color }};
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: {{ block.settings.date_spacing }}px;
  }

  .ai-blog-card-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 {{ block.settings.excerpt_spacing }}px 0;
    line-height: 1.3;
  }

  .ai-blog-card-excerpt-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.excerpt_size }}px;
    color: {{ block.settings.excerpt_color }};
    line-height: 1.6;
    margin: 0 0 {{ block.settings.link_spacing }}px 0;
    flex-grow: 1;
  }

  .ai-blog-card-link-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: 600;
    font-size: {{ block.settings.link_size }}px;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.3s ease;
  }

  .ai-blog-card-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-blog-card-link-{{ ai_gen_id }} svg {
    width: 16px;
    height: 16px;
    transition: transform 0.3s ease;
  }

  .ai-blog-card-{{ ai_gen_id }}:hover .ai-blog-card-link-{{ ai_gen_id }} svg {
    transform: translateX(4px);
  }

  .ai-blog-pagination-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }

  .ai-blog-pagination-link-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: 600;
    font-size: {{ block.settings.pagination_size }}px;
    color: {{ block.settings.pagination_color }};
    background-color: {{ block.settings.pagination_bg }};
    padding: 10px 18px;
    border-radius: {{ block.settings.pagination_border_radius }}px;
    text-decoration: none;
    transition: background-color 0.3s ease, color 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .ai-blog-pagination-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.pagination_hover_bg }};
    color: {{ block.settings.pagination_hover_color }};
  }

  .ai-blog-pagination-link-{{ ai_gen_id }} svg {
    width: 16px;
    height: 16px;
  }

  @media screen and (max-width: 989px) {
    .ai-blog-grid-container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-blog-grid-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-blog-card-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.card_title_size }}px * 0.9);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-blog-grid-container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-blog-grid-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-blog-card-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.card_title_size }}px * 0.85);
    }

    .ai-blog-grid-{{ ai_gen_id }} {
      padding: calc({{ block.settings.section_padding }}px * 0.6) 0;
    }
  }
{% endstyle %}

<blog-grid-{{ ai_gen_id }} class="ai-blog-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_header %}
    <div class="ai-blog-grid-header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-blog-grid-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <div class="ai-blog-grid-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
      {% endif %}
    </div>
  {% endif %}

  {% if block.settings.blog != blank %}
    {% paginate block.settings.blog.articles by block.settings.articles_per_page %}
      <div class="ai-blog-grid-container-{{ ai_gen_id }}">
        {% for article in block.settings.blog.articles %}
          <a href="{{ article.url }}" class="ai-blog-card-{{ ai_gen_id }}">
            <div class="ai-blog-card-image-wrapper-{{ ai_gen_id }}">
              {% if article.image %}
                <img
                  src="{{ article.image | image_url: width: 800 }}"
                  alt="{{ article.image.alt | escape }}"
                  class="ai-blog-card-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="800"
                  height="{{ 800 | divided_by: article.image.aspect_ratio | round }}"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <div class="ai-blog-card-content-{{ ai_gen_id }}">
              {% if block.settings.show_date %}
                <div class="ai-blog-card-date-{{ ai_gen_id }}">
                  {{ article.published_at | date: block.settings.date_format }}
                </div>
              {% endif %}
              <h3 class="ai-blog-card-title-{{ ai_gen_id }}">{{ article.title }}</h3>
              {% if block.settings.show_excerpt and article.excerpt != blank %}
                <div class="ai-blog-card-excerpt-{{ ai_gen_id }}">
                  {{ article.excerpt | strip_html | truncate: block.settings.excerpt_length }}
                </div>
              {% endif %}
              <span class="ai-blog-card-link-{{ ai_gen_id }}">
                {{ block.settings.read_more_text }}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </span>
            </div>
          </a>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 and block.settings.show_pagination %}
        <div class="ai-blog-pagination-{{ ai_gen_id }}">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="ai-blog-pagination-link-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
              {{ block.settings.previous_text }}
            </a>
          {% endif %}
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="ai-blog-pagination-link-{{ ai_gen_id }}">
              {{ block.settings.next_text }}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          {% endif %}
        </div>
      {% endif %}
    {% endpaginate %}
  {% else %}
    <div class="ai-blog-grid-container-{{ ai_gen_id }}">
      {% for i in (1..block.settings.articles_per_page) %}
        <div class="ai-blog-card-{{ ai_gen_id }}">
          <div class="ai-blog-card-image-wrapper-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
          <div class="ai-blog-card-content-{{ ai_gen_id }}">
            {% if block.settings.show_date %}
              <div class="ai-blog-card-date-{{ ai_gen_id }}">JUL 9, 2026</div>
            {% endif %}
            <h3 class="ai-blog-card-title-{{ ai_gen_id }}">Select a blog to display articles</h3>
            {% if block.settings.show_excerpt %}
              <div class="ai-blog-card-excerpt-{{ ai_gen_id }}">
                Choose a blog from the block settings to show your articles here.
              </div>
            {% endif %}
            <span class="ai-blog-card-link-{{ ai_gen_id }}">
              {{ block.settings.read_more_text }}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </span>
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</blog-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class BlogGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('blog-grid-{{ ai_gen_id }}', BlogGrid{{ ai_gen_id }});
  })();
</script>

