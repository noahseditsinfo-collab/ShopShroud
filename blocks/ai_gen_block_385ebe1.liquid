{% doc %}
  @prompt
    HELP CENTER
    
    How can we help?
    Everything about your order, our products, sizing, and our mission — in one place. Search below or browse by topic.
    
    
    All
    Shipping & Delivery
    Orders & Tracking
    Returns & Exchanges
    Sizing & Fit
    Products & Care, can you make sure they link to the right question when searched or clicked
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-help-center-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-help-center__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-help-center__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-help-center__title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    line-height: 1.2;
  }

  .ai-help-center__subtitle-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0 0 {{ block.settings.search_spacing }}px 0;
    line-height: 1.5;
  }

  .ai-help-center__search-{{ ai_gen_id }} {
    position: relative;
    max-width: {{ block.settings.search_max_width }}px;
    margin: 0 auto {{ block.settings.categories_spacing }}px;
  }

  .ai-help-center__search-input-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.search_padding }}px {{ block.settings.search_padding | plus: 40 }}px {{ block.settings.search_padding }}px {{ block.settings.search_padding }}px;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: {{ block.settings.search_font_size }}px;
    border: {{ block.settings.search_border_width }}px solid {{ block.settings.search_border_color }};
    border-radius: {{ block.settings.search_border_radius }}px;
    background-color: {{ block.settings.search_background }};
    color: {{ block.settings.text_color }};
  }

  .ai-help-center__search-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.placeholder_color }};
  }

  .ai-help-center__search-input-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.accent_color }};
    outline-offset: 2px;
  }

  .ai-help-center__search-icon-{{ ai_gen_id }} {
    position: absolute;
    right: {{ block.settings.search_padding }}px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: {{ block.settings.icon_color }};
  }

  .ai-help-center__categories-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.category_gap }}px;
    justify-content: center;
    margin-bottom: {{ block.settings.questions_spacing }}px;
  }

  .ai-help-center__category-{{ ai_gen_id }} {
    padding: {{ block.settings.category_padding_vertical }}px {{ block.settings.category_padding_horizontal }}px;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: {{ block.settings.category_font_size }}px;
    border: {{ block.settings.category_border_width }}px solid {{ block.settings.category_border_color }};
    border-radius: {{ block.settings.category_border_radius }}px;
    background-color: {{ block.settings.category_background }};
    color: {{ block.settings.category_text_color }};
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-help-center__category-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.category_hover_background }};
    color: {{ block.settings.category_hover_text }};
    border-color: {{ block.settings.category_hover_border }};
  }

  .ai-help-center__category-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.category_active_background }};
    color: {{ block.settings.category_active_text }};
    border-color: {{ block.settings.category_active_border }};
  }

  .ai-help-center__questions-{{ ai_gen_id }} {
    max-width: {{ block.settings.questions_max_width }}px;
    margin: 0 auto;
  }

  .ai-help-center__question-{{ ai_gen_id }} {
    border-bottom: 1px solid {{ block.settings.question_border_color }};
    padding: {{ block.settings.question_padding }}px 0;
  }

  .ai-help-center__question-{{ ai_gen_id }}.hidden {
    display: none;
  }

  .ai-help-center__question-button-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }

  .ai-help-center__question-text-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: {{ block.settings.question_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.question_text_color }};
    line-height: 1.4;
  }

  .ai-help-center__question-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    color: {{ block.settings.icon_color }};
    transition: transform 0.3s ease;
  }

  .ai-help-center__question-{{ ai_gen_id }}.open .ai-help-center__question-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-help-center__answer-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-help-center__answer-content-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: {{ block.settings.answer_font_size }}px;
    color: {{ block.settings.answer_text_color }};
    line-height: 1.6;
    padding-top: {{ block.settings.answer_padding }}px;
  }

  .ai-help-center__no-results-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
  }

  .ai-help-center__no-results-{{ ai_gen_id }}.hidden {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .ai-help-center__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-help-center__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-help-center__categories-{{ ai_gen_id }} {
      gap: {{ block.settings.category_gap | times: 0.7 }}px;
    }

    .ai-help-center__category-{{ ai_gen_id }} {
      font-size: {{ block.settings.category_font_size | times: 0.9 }}px;
      padding: {{ block.settings.category_padding_vertical | times: 0.8 }}px {{ block.settings.category_padding_horizontal | times: 0.8 }}px;
    }
  }
{% endstyle %}

<help-center-{{ ai_gen_id }} class="ai-help-center-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-help-center__container-{{ ai_gen_id }}">
    <div class="ai-help-center__header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h1 class="ai-help-center__title-{{ ai_gen_id }}">{{ block.settings.title }}</h1>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-help-center__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="ai-help-center__search-{{ ai_gen_id }}">
      <input
        type="text"
        class="ai-help-center__search-input-{{ ai_gen_id }}"
        placeholder="{{ block.settings.search_placeholder }}"
        aria-label="Search help articles"
      >
      <svg class="ai-help-center__search-icon-{{ ai_gen_id }}" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M9 17A8 8 0 1 0 9 1a8 8 0 0 0 0 16zM19 19l-4.35-4.35" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>

    <div class="ai-help-center__categories-{{ ai_gen_id }}">
      <button class="ai-help-center__category-{{ ai_gen_id }} active" data-category="all">
        {{ block.settings.category_all }}
      </button>
      <button class="ai-help-center__category-{{ ai_gen_id }}" data-category="shipping">
        {{ block.settings.category_shipping }}
      </button>
      <button class="ai-help-center__category-{{ ai_gen_id }}" data-category="orders">
        {{ block.settings.category_orders }}
      </button>
      <button class="ai-help-center__category-{{ ai_gen_id }}" data-category="returns">
        {{ block.settings.category_returns }}
      </button>
      <button class="ai-help-center__category-{{ ai_gen_id }}" data-category="sizing">
        {{ block.settings.category_sizing }}
      </button>
      <button class="ai-help-center__category-{{ ai_gen_id }}" data-category="products">
        {{ block.settings.category_products }}
      </button>
    </div>

    <div class="ai-help-center__questions-{{ ai_gen_id }}">
      {% for i in (1..20) %}
        {% liquid
          assign question_key = 'question_' | append: i
          assign answer_key = 'answer_' | append: i
          assign category_key = 'question_' | append: i | append: '_category'
          
          assign question = block.settings[question_key]
          assign answer = block.settings[answer_key]
          assign category = block.settings[category_key]
        %}
        
        {% if question != blank and answer != blank %}
          <div class="ai-help-center__question-{{ ai_gen_id }}" data-category="{{ category }}">
            <button class="ai-help-center__question-button-{{ ai_gen_id }}" aria-expanded="false">
              <span class="ai-help-center__question-text-{{ ai_gen_id }}">{{ question }}</span>
              <svg class="ai-help-center__question-icon-{{ ai_gen_id }}" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="ai-help-center__answer-{{ ai_gen_id }}">
              <div class="ai-help-center__answer-content-{{ ai_gen_id }}">{{ answer }}</div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-help-center__no-results-{{ ai_gen_id }} hidden">
      {{ block.settings.no_results_text }}
    </div>
  </div>
</help-center-{{ ai_gen_id }}>

<script>
  (function() {
    class HelpCenter{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.searchInput = this.querySelector('.ai-help-center__search-input-{{ ai_gen_id }}');
        this.categoryButtons = this.querySelectorAll('.ai-help-center__category-{{ ai_gen_id }}');
        this.questions = this.querySelectorAll('.ai-help-center__question-{{ ai_gen_id }}');
        this.noResults = this.querySelector('.ai-help-center__no-results-{{ ai_gen_id }}');
        this.currentCategory = 'all';

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.searchInput.addEventListener('input', (e) => {
          this.handleSearch(e.target.value);
        });

        this.categoryButtons.forEach((button) => {
          button.addEventListener('click', () => {
            this.handleCategoryClick(button);
          });
        });

        this.questions.forEach((question) => {
          const button = question.querySelector('.ai-help-center__question-button-{{ ai_gen_id }}');
          const answer = question.querySelector('.ai-help-center__answer-{{ ai_gen_id }}');
          
          button.addEventListener('click', () => {
            this.toggleQuestion(question, button, answer);
          });
        });
      }

      handleSearch(searchTerm) {
        const term = searchTerm.toLowerCase().trim();
        let visibleCount = 0;

        this.questions.forEach((question) => {
          const questionText = question.querySelector('.ai-help-center__question-text-{{ ai_gen_id }}').textContent.toLowerCase();
          const answerText = question.querySelector('.ai-help-center__answer-content-{{ ai_gen_id }}').textContent.toLowerCase();
          const category = question.getAttribute('data-category');
          
          const matchesSearch = term === '' || questionText.includes(term) || answerText.includes(term);
          const matchesCategory = this.currentCategory === 'all' || category === this.currentCategory;
          
          if (matchesSearch && matchesCategory) {
            question.classList.remove('hidden');
            visibleCount++;
          } else {
            question.classList.add('hidden');
            this.closeQuestion(question);
          }
        });

        if (visibleCount === 0) {
          this.noResults.classList.remove('hidden');
        } else {
          this.noResults.classList.add('hidden');
        }
      }

      handleCategoryClick(clickedButton) {
        this.categoryButtons.forEach((btn) => btn.classList.remove('active'));
        clickedButton.classList.add('active');
        
        this.currentCategory = clickedButton.getAttribute('data-category');
        this.handleSearch(this.searchInput.value);
      }

      toggleQuestion(question, button, answer) {
        const isOpen = question.classList.contains('open');
        
        if (isOpen) {
          this.closeQuestion(question);
        } else {
          this.openQuestion(question, button, answer);
        }
      }

      openQuestion(question, button, answer) {
        question.classList.add('open');
        button.setAttribute('aria-expanded', 'true');
        answer.style.maxHeight = answer.scrollHeight + 'px';
      }

      closeQuestion(question) {
        const button = question.querySelector('.ai-help-center__question-button-{{ ai_gen_id }}');
        const answer = question.querySelector('.ai-help-center__answer-{{ ai_gen_id }}');
        
        question.classList.remove('open');
        button.setAttribute('aria-expanded', 'false');
        answer.style.maxHeight = '0';
      }
    }

    customElements.define('help-center-{{ ai_gen_id }}', HelpCenter{{ ai_gen_id }});
  })();
</script>

