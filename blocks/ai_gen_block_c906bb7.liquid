{% doc %}
  @prompt
    Update the existing "Detox launch countdown" block to replace the hardcoded brand name text with an image_picker setting labeled "Logo" so the merchant can upload their own logo image. Where the brand name currently displays, show the uploaded logo image (max-height ~80px, centered, white if possible via CSS filter). If no logo is uploaded, fall back to displaying the store name as text. Keep all existing functionality intact: black background, white text, countdown timer with days/hours/minutes/seconds, headline, SMS opt-in form, and UNLOCK ACCESS button.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-detox-countdown-{{ ai_gen_id }} {
    display: block;
    background-color: #000000;
    color: #ffffff;
    padding: 60px 20px;
    text-align: center;
    width: 100%;
  }

  .ai-detox-countdown__container-{{ ai_gen_id }} {
    max-width: 800px;
    margin: 0 auto;
  }

  .ai-detox-countdown__logo-{{ ai_gen_id }} {
    margin-bottom: 30px;
  }

  .ai-detox-countdown__logo-image-{{ ai_gen_id }} {
    max-height: 80px;
    width: auto;
    display: inline-block;
    filter: brightness(0) invert(1);
  }

  .ai-detox-countdown__brand-text-{{ ai_gen_id }} {
    font-size: 32px;
    font-weight: 700;
    margin: 0;
    color: #ffffff;
  }

  .ai-detox-countdown__headline-{{ ai_gen_id }} {
    font-size: 48px;
    font-weight: 700;
    margin: 0 0 20px;
    line-height: 1.2;
  }

  .ai-detox-countdown__subheadline-{{ ai_gen_id }} {
    font-size: 18px;
    margin: 0 0 40px;
    opacity: 0.9;
  }

  .ai-detox-countdown__timer-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 30px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .ai-detox-countdown__timer-unit-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ai-detox-countdown__timer-value-{{ ai_gen_id }} {
    font-size: 56px;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 8px;
  }

  .ai-detox-countdown__timer-label-{{ ai_gen_id }} {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.7;
  }

  .ai-detox-countdown__form-{{ ai_gen_id }} {
    margin-bottom: 30px;
  }

  .ai-detox-countdown__form-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: 10px;
    max-width: 500px;
    margin: 0 auto 20px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .ai-detox-countdown__input-{{ ai_gen_id }} {
    flex: 1;
    min-width: 200px;
    padding: 15px 20px;
    border: 2px solid #ffffff;
    background-color: transparent;
    color: #ffffff;
    font-size: 16px;
    border-radius: 4px;
  }

  .ai-detox-countdown__input-{{ ai_gen_id }}::placeholder {
    color: rgba(255, 255, 255, 0.6);
  }

  .ai-detox-countdown__submit-{{ ai_gen_id }} {
    padding: 15px 30px;
    background-color: #ffffff;
    color: #000000;
    border: none;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    border-radius: 4px;
    transition: opacity 0.3s ease;
  }

  .ai-detox-countdown__submit-{{ ai_gen_id }}:hover {
    opacity: 0.9;
  }

  .ai-detox-countdown__disclaimer-{{ ai_gen_id }} {
    font-size: 12px;
    opacity: 0.7;
    margin-bottom: 30px;
  }

  .ai-detox-countdown__cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: 18px 40px;
    background-color: #ffffff;
    color: #000000;
    text-decoration: none;
    font-size: 18px;
    font-weight: 700;
    border-radius: 4px;
    transition: opacity 0.3s ease;
  }

  .ai-detox-countdown__cta-{{ ai_gen_id }}:hover {
    opacity: 0.9;
  }

  .ai-detox-countdown__success-{{ ai_gen_id }} {
    color: #4ade80;
    margin-top: 10px;
    font-size: 14px;
  }

  .ai-detox-countdown__error-{{ ai_gen_id }} {
    color: #f87171;
    margin-top: 10px;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-detox-countdown__headline-{{ ai_gen_id }} {
      font-size: 32px;
    }

    .ai-detox-countdown__timer-value-{{ ai_gen_id }} {
      font-size: 40px;
    }

    .ai-detox-countdown__timer-{{ ai_gen_id }} {
      gap: 20px;
    }

    .ai-detox-countdown__form-wrapper-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-detox-countdown__input-{{ ai_gen_id }},
    .ai-detox-countdown__submit-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<detox-countdown-{{ ai_gen_id }}
  class="ai-detox-countdown-{{ ai_gen_id }}"
  data-launch-date="{{ block.settings.launch_date }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-detox-countdown__container-{{ ai_gen_id }}">
    <div class="ai-detox-countdown__logo-{{ ai_gen_id }}">
      {% if block.settings.logo %}
        <img
          src="{{ block.settings.logo | image_url: width: 400 }}"
          alt="{{ shop.name }}"
          class="ai-detox-countdown__logo-image-{{ ai_gen_id }}"
          loading="lazy"
          width="400"
          height="{{ block.settings.logo.height | times: 400 | divided_by: block.settings.logo.width }}"
        >
      {% else %}
        <h2 class="ai-detox-countdown__brand-text-{{ ai_gen_id }}">{{ shop.name }}</h2>
      {% endif %}
    </div>

    <h1 class="ai-detox-countdown__headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h1>
    
    {% if block.settings.subheadline != blank %}
      <p class="ai-detox-countdown__subheadline-{{ ai_gen_id }}">{{ block.settings.subheadline }}</p>
    {% endif %}

    <div class="ai-detox-countdown__timer-{{ ai_gen_id }}">
      <div class="ai-detox-countdown__timer-unit-{{ ai_gen_id }}">
        <div class="ai-detox-countdown__timer-value-{{ ai_gen_id }}" data-days>00</div>
        <div class="ai-detox-countdown__timer-label-{{ ai_gen_id }}">Days</div>
      </div>
      <div class="ai-detox-countdown__timer-unit-{{ ai_gen_id }}">
        <div class="ai-detox-countdown__timer-value-{{ ai_gen_id }}" data-hours>00</div>
        <div class="ai-detox-countdown__timer-label-{{ ai_gen_id }}">Hours</div>
      </div>
      <div class="ai-detox-countdown__timer-unit-{{ ai_gen_id }}">
        <div class="ai-detox-countdown__timer-value-{{ ai_gen_id }}" data-minutes>00</div>
        <div class="ai-detox-countdown__timer-label-{{ ai_gen_id }}">Minutes</div>
      </div>
      <div class="ai-detox-countdown__timer-unit-{{ ai_gen_id }}">
        <div class="ai-detox-countdown__timer-value-{{ ai_gen_id }}" data-seconds>00</div>
        <div class="ai-detox-countdown__timer-label-{{ ai_gen_id }}">Seconds</div>
      </div>
    </div>

    <div class="ai-detox-countdown__form-{{ ai_gen_id }}">
      {%- form 'contact' -%}
        <input
          type="hidden"
          name="contact[tags]"
          value="sms-opt-in"
        >
        <div class="ai-detox-countdown__form-wrapper-{{ ai_gen_id }}">
          <input
            type="tel"
            name="contact[phone]"
            class="ai-detox-countdown__input-{{ ai_gen_id }}"
            placeholder="{{ block.settings.phone_placeholder }}"
            aria-required="true"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="ai-detox-countdown-error-{{ ai_gen_id }}"
            {% endif %}
            {% if form.posted_successfully? %}
              aria-describedby="ai-detox-countdown-success-{{ ai_gen_id }}"
            {% endif %}
            required
          >
          <button
            type="submit"
            class="ai-detox-countdown__submit-{{ ai_gen_id }}"
          >
            {{ block.settings.submit_button_text }}
          </button>
        </div>
        {%- if form.errors -%}
          <div
            id="ai-detox-countdown-error-{{ ai_gen_id }}"
            class="ai-detox-countdown__error-{{ ai_gen_id }}"
          >
            <span>{{ form.errors.messages.phone }}</span>
          </div>
        {%- endif -%}
        {%- if form.posted_successfully? -%}
          <div
            id="ai-detox-countdown-success-{{ ai_gen_id }}"
            class="ai-detox-countdown__success-{{ ai_gen_id }}"
          >
            <span>{{ block.settings.success_message }}</span>
          </div>
        {%- endif -%}
      {%- endform -%}
      
      {% if block.settings.disclaimer != blank %}
        <p class="ai-detox-countdown__disclaimer-{{ ai_gen_id }}">{{ block.settings.disclaimer }}</p>
      {% endif %}
    </div>

    {% if block.settings.cta_text != blank %}
      <a
        href="{{ block.settings.cta_link }}"
        class="ai-detox-countdown__cta-{{ ai_gen_id }}"
      >
        {{ block.settings.cta_text }}
      </a>
    {% endif %}
  </div>
</detox-countdown-{{ ai_gen_id }}>

<script>
  (function() {
    class DetoxCountdown{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.launchDate = this.dataset.launchDate;
      }

      connectedCallback() {
        if (!this.launchDate) return;

        this.daysEl = this.querySelector('[data-days]');
        this.hoursEl = this.querySelector('[data-hours]');
        this.minutesEl = this.querySelector('[data-minutes]');
        this.secondsEl = this.querySelector('[data-seconds]');

        this.updateCountdown();
        this.interval = setInterval(() => this.updateCountdown(), 1000);
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }

      updateCountdown() {
        const now = new Date().getTime();
        const launch = new Date(this.launchDate).getTime();
        const distance = launch - now;

        if (distance < 0) {
          clearInterval(this.interval);
          this.daysEl.textContent = '00';
          this.hoursEl.textContent = '00';
          this.minutesEl.textContent = '00';
          this.secondsEl.textContent = '00';
          return;
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        this.daysEl.textContent = String(days).padStart(2, '0');
        this.hoursEl.textContent = String(hours).padStart(2, '0');
        this.minutesEl.textContent = String(minutes).padStart(2, '0');
        this.secondsEl.textContent = String(seconds).padStart(2, '0');
      }
    }

    customElements.define('detox-countdown-{{ ai_gen_id }}', DetoxCountdown{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Detox launch countdown",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "headline",
      "label": "Headline",
      "default": "THE DETOX IS COMING"
    },
    {
      "type": "inline_richtext",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "Get ready for a digital reset"
    },
    {
      "type": "text",
      "id": "launch_date",
      "label": "Launch date",
      "info": "Format: YYYY-MM-DD HH:MM:SS (e.g., 2026-12-31 23:59:59)"
    },
    {
      "type": "header",
      "content": "SMS opt-in form"
    },
    {
      "type": "inline_richtext",
      "id": "phone_placeholder",
      "label": "Phone placeholder",
      "default": "Enter your phone number"
    },
    {
      "type": "inline_richtext",
      "id": "submit_button_text",
      "label": "Submit button text",
      "default": "NOTIFY ME"
    },
    {
      "type": "inline_richtext",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks! We'll text you when we launch."
    },
    {
      "type": "inline_richtext",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "By submitting, you agree to receive SMS updates. Message and data rates may apply."
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "inline_richtext",
      "id": "cta_text",
      "label": "Button text",
      "default": "UNLOCK ACCESS"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Detox launch countdown"
    }
  ]
}
{% endschema %}
