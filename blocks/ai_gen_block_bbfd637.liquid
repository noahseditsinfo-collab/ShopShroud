{% doc %}
  @prompt
    add the password section to access the webbsite 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-password-gate-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.vertical_padding }}px 24px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    text-align: center;
  }

  .ai-password-gate-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
  }

  .ai-password-gate-{{ ai_gen_id }}__logo {
    display: block;
    width: {{ block.settings.logo_width }}px;
    max-width: 100%;
    height: auto;
    margin: 0 auto 28px;
  }

  .ai-password-gate-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 12px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ai-password-gate-{{ ai_gen_id }}__heading {
    margin: 0 0 14px;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.05;
  }

  .ai-password-gate-{{ ai_gen_id }}__message {
    margin: 0 auto 28px;
    max-width: 480px;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
    font-size: 16px;
    line-height: 1.6;
  }

  .ai-password-gate-{{ ai_gen_id }}__form {
    display: flex;
    gap: 10px;
    align-items: stretch;
    text-align: left;
  }

  .ai-password-gate-{{ ai_gen_id }}__input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 15px 16px;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.input_background }};
    color: {{ block.settings.text_color }};
    font: inherit;
    font-size: 16px;
  }

  .ai-password-gate-{{ ai_gen_id }}__input:focus-visible,
  .ai-password-gate-{{ ai_gen_id }}__button:focus-visible {
    outline: 3px solid {{ block.settings.accent_color }};
    outline-offset: 3px;
  }

  .ai-password-gate-{{ ai_gen_id }}__button {
    flex: 0 0 auto;
    padding: 15px 24px;
    border: 1px solid {{ block.settings.button_background }};
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    cursor: pointer;
    font: inherit;
    font-weight: 700;
    transition: opacity 0.2s ease;
  }

  .ai-password-gate-{{ ai_gen_id }}__button:hover {
    opacity: 0.82;
  }

  .ai-password-gate-{{ ai_gen_id }}__error {
    margin: 14px 0 0;
    color: {{ block.settings.error_color }};
    font-size: 14px;
    line-height: 1.5;
  }

  .ai-password-gate-{{ ai_gen_id }}__footer {
    margin: 24px 0 0;
    color: {{ block.settings.muted_color }};
    font-size: 13px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-password-gate-{{ ai_gen_id }} {
      padding-right: 18px;
      padding-left: 18px;
    }

    .ai-password-gate-{{ ai_gen_id }}__form {
      flex-direction: column;
    }

    .ai-password-gate-{{ ai_gen_id }}__button {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-password-gate-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-password-gate-{{ ai_gen_id }}__inner">
    {% if block.settings.logo %}
      <img
        class="ai-password-gate-{{ ai_gen_id }}__logo"
        src="{{ block.settings.logo | image_url: width: 600 }}"
        alt="{{ shop.name | escape }}"
        width="{{ block.settings.logo.width }}"
        height="{{ block.settings.logo.height }}"
        loading="eager"
      >
    {% endif %}

    {% if block.settings.eyebrow != blank %}
      <p class="ai-password-gate-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>
    {% endif %}

    <h1 class="ai-password-gate-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h1>
    <p class="ai-password-gate-{{ ai_gen_id }}__message">{{ block.settings.message | escape }}</p>

    {% form 'storefront_password' %}
      <div class="ai-password-gate-{{ ai_gen_id }}__form">
        <label class="visually-hidden" for="Password-{{ ai_gen_id }}">{{ block.settings.input_label | escape }}</label>
        <input
          id="Password-{{ ai_gen_id }}"
          class="ai-password-gate-{{ ai_gen_id }}__input"
          type="password"
          name="password"
          placeholder="{{ block.settings.input_placeholder | escape }}"
          autocomplete="current-password"
          required
        >
        <button class="ai-password-gate-{{ ai_gen_id }}__button" type="submit">{{ block.settings.button_label | escape }}</button>
      </div>

      {% if form.errors %}
        <p class="ai-password-gate-{{ ai_gen_id }}__error" role="alert">{{ block.settings.error_message | escape }}</p>
      {% endif %}
    {% endform %}

    {% if block.settings.footer_text != blank %}
      <p class="ai-password-gate-{{ ai_gen_id }}__footer">{{ block.settings.footer_text | escape }}</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Password access",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Coming soon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Enter the password"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Message",
      "default": "This site is currently private. Enter the store password to continue."
    },
    {
      "type": "text",
      "id": "input_label",
      "label": "Input label",
      "default": "Store password"
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Placeholder",
      "default": "Enter store password"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Enter"
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error message",
      "default": "That password was not recognized. Please try again."
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Check back soon for the official launch."
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical padding",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 320,
      "step": 20,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 28,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#DDDDDD"
    },
    {
      "type": "color",
      "id": "input_background",
      "label": "Input background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#4D4D4D"
    },
    {
      "type": "color",
      "id": "error_color",
      "label": "Error text",
      "default": "#8A1C1C"
    }
  ],
  "presets": [
    {
      "name": "Password access"
    }
  ],
  "tag": null,
  "class": "password-access-block"
}
{% endschema %}