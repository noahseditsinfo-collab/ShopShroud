    "theme_documentation_url": "https://shopshroud.com",
    "theme_support_url": "https://shopshroud.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_background_secondary",
        "label": "Secondary background (cards, tiles)",
        "default": "#F1F1F1"
      },
      {
        "type": "color",
        "id": "color_dark_panel",
        "label": "Dark panel background (announcement bar, newsletter)",
        "default": "#0A0A0A"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#0A0A0A"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (buttons, links)",
        "default": "#0A0A0A"
      },
      {
        "type": "color",
        "id": "color_accent_secondary",
        "label": "Accent secondary (sale badges, highlights)",
        "default": "#4D4D4D"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Borders / dividers",
        "default": "#DDDDDD"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "archivo_black_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "work_sans_n4"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1280
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      }
