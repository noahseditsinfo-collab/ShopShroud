<section class="customer-page page-width">
  <h1>Reset your password</h1>
  {% form 'reset_customer_password' %}
    {%- if form.errors -%}
      <div class="form-errors">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <label for="ResetPassword">New password</label>
    <input type="password" name="customer[password]" id="ResetPassword" required>
    <label for="ResetPasswordConfirm">Confirm password</label>
    <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" required>
    <button type="submit" class="button button--primary">Reset password</button>
  {% endform %}
</section>
