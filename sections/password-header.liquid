<div class="password-header">
  {%- if section.settings.logo != blank -%}
    <img class="password-header__logo-image" src="{{ section.settings.logo | image_url: width: 320 }}" alt="{{ shop.name }}" width="160" height="{{ 160 | divided_by: section.settings.logo.aspect_ratio }}">
  {%- else -%}
    <p class="password-header__logo-text">{{ shop.name }}</p>
  {%- endif -%}

  {%- if section.settings.tagline != blank -%}
    <p class="password-header__tagline">{{ section.settings.tagline }}</p>
  {%- endif -%}

  <button type="button" class="password-header__toggle" data-password-toggle>
    <svg viewBox="0 0 24 24" width="12" height="14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="1.5"/><path d="M7.5 10V7a4.5 4.5 0 0 1 9 0v3"/></svg>
    Enter using password
  </button>

  <div class="password-header__form-panel" data-password-panel hidden>
    {%- form 'storefront_password', class: 'password-header__form' -%}
      {%- if form.errors -%}
        <p class="password-header__error">{{ form.errors.messages['form'] | default: "Wrong password, please try again." }}</p>
      {%- endif -%}
      <input type="password" name="password" id="Password" placeholder="Enter store password" required>
      <button type="submit" class="button button--secondary">Enter</button>
    {%- endform -%}
  </div>
</div>

<style>
  .password-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .password-header__logo-image {
    max-height: 60px;
    width: auto;
    margin-bottom: 0.25rem;
  }
  .password-header__logo-text {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 2rem;
    color: #ffffff;
    margin: 0;
  }
  .password-header__tagline {
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    opacity: 0.7;
    margin: 0 0 0.5rem;
  }
  .password-header__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: none;
    color: #ffffff;
    font-size: 0.8rem;
    text-decoration: underline;
    letter-spacing: 0.02em;
    cursor: pointer;
    padding: 0.25rem 0;
  }
  .password-header__form-panel {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }
  .password-header__form-panel.is-open {
    display: flex;
  }
  .password-header__form {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .password-header__form input[type="password"] {
    padding: 0.65rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: transparent;
    color: #ffffff;
    border-radius: 2px;
    min-width: 220px;
  }
  .password-header__form input[type="password"]::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }
  .password-header__form .button--secondary {
    border-color: #ffffff;
    color: #ffffff;
  }
  .password-header__form .button--secondary:hover {
    background: #ffffff;
    color: #0A0A0A;
  }
  .password-header__error {
    color: #ff6b6b;
    font-size: 0.8rem;
    margin: 0 0 0.25rem;
  }
</style>

<script>
  (function () {
    var toggle = document.querySelector('[data-password-toggle]');
    var panel = document.querySelector('[data-password-panel]');
    if (!toggle || !panel) return;
    toggle.addEventListener('click', function () {
      var isOpen = panel.classList.toggle('is-open');
      panel.hidden = !isOpen;
      if (isOpen) {
        var input = panel.querySelector('input[type="password"]');
        if (input) input.focus();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Password header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (optional, falls back to store name)" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "You are not alone." }
  ]
}
{% endschema %}
