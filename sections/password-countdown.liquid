{%- if section.settings.enable_timer and section.settings.end_datetime != blank -%}
  <div class="password-countdown">
    {%- if section.settings.heading != blank -%}
      <p class="password-countdown__heading">{{ section.settings.heading }}</p>
    {%- endif -%}
    <div class="password-countdown__timer" data-countdown data-end="{{ section.settings.end_datetime }}">
      <div class="password-countdown__unit">
        <span data-countdown-days>00</span>
        <small>Days</small>
      </div>
      <div class="password-countdown__unit">
        <span data-countdown-hours>00</span>
        <small>Hours</small>
      </div>
      <div class="password-countdown__unit">
        <span data-countdown-minutes>00</span>
        <small>Minutes</small>
      </div>
      <div class="password-countdown__unit">
        <span data-countdown-seconds>00</span>
        <small>Seconds</small>
      </div>
    </div>
    <p class="password-countdown__ended" data-countdown-ended hidden>{{ section.settings.ended_text | default: "We're live." }}</p>
  </div>
{%- endif -%}

<style>
  .password-countdown {
    margin-bottom: 2.5rem;
  }
  .password-countdown__heading {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.7;
    margin: 0 0 1rem;
  }
  .password-countdown__timer {
    display: flex;
    gap: {{ section.settings.unit_gap | default: 12 }}px;
    justify-content: center;
  }
  .password-countdown__unit span {
    display: block;
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: {{ section.settings.number_size | default: 34 }}px;
    line-height: 1;
    color: {{ section.settings.number_color | default: '#ffffff' }};
  }
  .password-countdown__unit small {
    display: block;
    margin-top: 0.4rem;
    font-size: {{ section.settings.label_size | default: 11 }}px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: {{ section.settings.label_color | default: '#ffffff' }};
    opacity: 0.65;
  }
  .password-countdown__ended {
    font-size: 1rem;
    letter-spacing: 0.04em;
  }
</style>

<script>
  (function () {
    var el = document.querySelector('[data-countdown]');
    if (!el) return;
    var end = new Date(el.getAttribute('data-end')).getTime();
    var daysEl = el.querySelector('[data-countdown-days]');
    var hoursEl = el.querySelector('[data-countdown-hours]');
    var minutesEl = el.querySelector('[data-countdown-minutes]');
    var secondsEl = el.querySelector('[data-countdown-seconds]');
    var endedEl = document.querySelector('[data-countdown-ended]');

    function pad(n) { return n < 10 ? '0' + n : '' + n; }

    function tick() {
      var diff = end - Date.now();
      if (diff <= 0) {
        el.style.display = 'none';
        if (endedEl) endedEl.hidden = false;
        clearInterval(timer);
        return;
      }
      var d = Math.floor(diff / 86400000);
      var h = Math.floor((diff % 86400000) / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      if (daysEl) daysEl.textContent = pad(d);
      if (hoursEl) hoursEl.textContent = pad(h);
      if (minutesEl) minutesEl.textContent = pad(m);
      if (secondsEl) secondsEl.textContent = pad(s);
    }

    tick();
    var timer = setInterval(tick, 1000);
  })();
</script>

{% schema %}
{
  "name": "Password countdown",
  "settings": [
    { "type": "checkbox", "id": "enable_timer", "label": "Enable countdown timer", "default": true },
    { "type": "text", "id": "end_datetime", "label": "Timer end date/time (ISO format, e.g. 2026-09-01T09:00:00-04:00)" },
    { "type": "text", "id": "heading", "label": "Heading above timer (optional)" },
    { "type": "text", "id": "ended_text", "label": "Text shown once timer ends", "default": "We're live." },
    { "type": "color", "id": "number_color", "label": "Number color", "default": "#ffffff" },
    { "type": "color", "id": "label_color", "label": "Label color", "default": "#ffffff" },
    { "type": "range", "id": "number_size", "label": "Number text size", "min": 20, "max": 60, "step": 1, "unit": "px", "default": 34 },
    { "type": "range", "id": "label_size", "label": "Label text size", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "unit_gap", "label": "Gap between units", "min": 4, "max": 32, "step": 1, "unit": "px", "default": 12 }
  ],
  "presets": [
    { "name": "Password countdown" }
  ]
}
{% endschema %}
