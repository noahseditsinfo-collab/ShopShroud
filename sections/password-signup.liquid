<div class="password-signup">
  <h2 class="password-signup__heading">{{ section.settings.heading | default: 'Get Early Access' }}</h2>
  {%- if section.settings.subheading != blank -%}
    <p class="password-signup__subheading">{{ section.settings.subheading }}</p>
  {%- endif -%}

  <form class="password-signup__form" data-klaviyo-sms-form
    data-company-id="{{ section.settings.klaviyo_company_id }}"
    data-list-id="{{ section.settings.klaviyo_list_id }}">
    <div class="password-signup__field">
      <span class="password-signup__prefix">🇺🇸 +1</span>
      <input type="tel" name="phone" inputmode="numeric" placeholder="Please enter your phone number" required data-phone-input>
    </div>
    <button type="submit" class="password-signup__submit">
      <span data-submit-label>{{ section.settings.button_label | default: 'Get Early Access' }}</span>
    </button>
  </form>

  <p class="password-signup__status" data-signup-status hidden></p>

  {%- if section.settings.consent_text != blank -%}
    <p class="password-signup__consent">{{ section.settings.consent_text }}</p>
  {%- else -%}
    <p class="password-signup__consent">
      By signing up via text you agree to receive recurring automated marketing messages from {{ shop.name }} at the phone number provided. Consent is not a condition of purchase. Msg &amp; data rates may apply. Msg frequency varies. Reply STOP to unsubscribe, HELP for help.
      {%- if shop.privacy_policy -%} View <a href="{{ shop.privacy_policy.url }}">Privacy Policy</a>{%- endif -%}
      {%- if shop.terms_of_service -%} &amp; <a href="{{ shop.terms_of_service.url }}">Terms</a>{%- endif -%}.
    </p>
  {%- endif -%}

  {%- unless section.settings.klaviyo_company_id != blank and section.settings.klaviyo_list_id != blank -%}
    <p class="password-signup__admin-note">Admin note: add your Klaviyo Public API Key and SMS List ID in the section settings for this form to actually submit signups.</p>
  {%- endunless -%}
</div>

<style>
  .password-signup {
    width: 100%;
    max-width: 380px;
  }
  .password-signup__heading {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 1.4rem;
    color: #ffffff;
    margin: 0 0 0.6rem;
  }
  .password-signup__subheading {
    font-size: 0.88rem;
    opacity: 0.75;
    margin: 0 0 1.5rem;
  }
  .password-signup__form {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .password-signup__field {
    display: flex;
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.03);
    overflow: hidden;
  }
  .password-signup__prefix {
    padding: 0.75rem 0.6rem;
    font-size: 0.85rem;
    color: #ffffff;
    border-right: 1px solid rgba(255, 255, 255, 0.2);
    white-space: nowrap;
  }
  .password-signup__field input {
    flex: 1;
    padding: 0.75rem 0.75rem;
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 0.9rem;
  }
  .password-signup__field input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }
  .password-signup__field input:focus {
    outline: none;
  }
  .password-signup__submit {
    padding: 0.85rem 1rem;
    background: #ffffff;
    color: #0A0A0A;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.82rem;
    border: none;
    border-radius: 2px;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }
  .password-signup__submit:hover {
    opacity: 0.85;
  }
  .password-signup__submit[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .password-signup__status {
    margin-top: 0.75rem;
    font-size: 0.85rem;
  }
  .password-signup__status.is-success { color: #7CD992; }
  .password-signup__status.is-error { color: #ff6b6b; }
  .password-signup__consent {
    margin-top: 1rem;
    font-size: 0.68rem;
    line-height: 1.5;
    opacity: 0.55;
  }
  .password-signup__consent a {
    text-decoration: underline;
  }
  .password-signup__admin-note {
    margin-top: 0.75rem;
    font-size: 0.68rem;
    color: #ffcf6b;
    opacity: 0.9;
  }
</style>

<script>
  (function () {
    var form = document.querySelector('[data-klaviyo-sms-form]');
    if (!form) return;

    var statusEl = document.querySelector('[data-signup-status]');
    var submitBtn = form.querySelector('.password-signup__submit');
    var submitLabel = form.querySelector('[data-submit-label]');
    var originalLabel = submitLabel ? submitLabel.textContent : 'Submit';

    function setStatus(message, type) {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.hidden = false;
      statusEl.classList.remove('is-success', 'is-error');
      if (type) statusEl.classList.add(type);
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();

      var companyId = form.getAttribute('data-company-id');
      var listId = form.getAttribute('data-list-id');
      var phoneInput = form.querySelector('[data-phone-input]');
      var digits = (phoneInput.value || '').replace(/\D/g, '');

      if (digits.length < 10) {
        setStatus('Please enter a valid 10-digit phone number.', 'is-error');
        return;
      }

      if (!companyId || !listId) {
        setStatus('Signup form is not connected yet — check back soon.', 'is-error');
        return;
      }

      var fullPhone = '+1' + digits;

      submitBtn.disabled = true;
      if (submitLabel) submitLabel.textContent = 'Submitting…';

      fetch('https://a.klaviyo.com/client/subscriptions?company_id=' + encodeURIComponent(companyId), {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/vnd.api+json',
          'Revision': '2024-10-15'
        },
        body: JSON.stringify({
          data: {
            type: 'subscription',
            attributes: {
              custom_source: 'Password Page SMS Signup',
              profile: {
                data: {
                  type: 'profile',
                  attributes: {
                    phone_number: fullPhone,
                    subscriptions: {
                      sms: { marketing: { consent: 'SUBSCRIBED' } }
                    }
                  }
                }
              }
            },
            relationships: {
              list: {
                data: { type: 'list', id: listId }
              }
            }
          }
        })
      })
        .then(function (res) {
          if (res.ok || res.status === 202) {
            setStatus("You're on the list. We'll text you when we launch.", 'is-success');
            form.reset();
          } else {
            return res.json().then(function (body) {
              console.error('Klaviyo signup error', body);
              setStatus('Something went wrong — please try again.', 'is-error');
            }).catch(function () {
              setStatus('Something went wrong — please try again.', 'is-error');
            });
          }
        })
        .catch(function (err) {
          console.error('Klaviyo signup network error', err);
          setStatus('Something went wrong — please try again.', 'is-error');
        })
        .finally(function () {
          submitBtn.disabled = false;
          if (submitLabel) submitLabel.textContent = originalLabel;
        });
    });
  })();
</script>

{% schema %}
{
  "name": "Password SMS signup",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get Early Access" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Sign up to get exclusive access to our next drop." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get Early Access" },
    { "type": "text", "id": "klaviyo_company_id", "label": "Klaviyo Public API Key (Company ID)" },
    { "type": "text", "id": "klaviyo_list_id", "label": "Klaviyo SMS List ID" },
    { "type": "textarea", "id": "consent_text", "label": "Consent disclosure text (optional, sensible default provided)" }
  ],
  "presets": [
    { "name": "Password SMS signup" }
  ]
}
{% endschema %}
