<section class="brand-story page-width brand-story--{{ section.settings.layout }}">
  <div class="brand-story__image">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 900 }}" alt="" loading="lazy" width="900" height="{{ 900 | divided_by: section.settings.image.aspect_ratio }}">
    {%- endif -%}
  </div>
  <div class="brand-story__content">
    {%- if section.settings.eyebrow != blank -%}<p class="brand-story__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    <div class="brand-story__body">{{ section.settings.body }}</div>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="button button--secondary">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "settings": [
    { "type": "select", "id": "layout", "label": "Image position", "default": "left",
      "options": [
        { "value": "left", "label": "Image left" },
        { "value": "right", "label": "Image right" }
      ]
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built by people who wear it" },
    { "type": "richtext", "id": "body", "label": "Body text", "default": "<p>We started ShopShroud to make clothing that holds up to real life — made in small batches, tested by our own community, and priced fairly.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn our story" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Brand story" }
  ]
}
{% endschema %}
