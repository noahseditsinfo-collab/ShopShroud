<section class="faq-accordion">
  <h1>{{ section.settings.heading }}</h1>
  {%- for block in section.blocks -%}
    <div class="faq-item" {{ block.shopify_attributes }}>
      <button type="button" class="faq-item__question">
        {{ block.settings.question }}
        <span class="faq-item__icon">+</span>
      </button>
      <div class="faq-item__answer">{{ block.settings.answer }}</div>
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "FAQ accordion",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does shipping take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Most orders ship within 2-3 business days.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ accordion",
      "blocks": [
        { "type": "question", "settings": { "question": "How long does shipping take?", "answer": "<p>Most orders ship within 2-3 business days.</p>" } },
        { "type": "question", "settings": { "question": "What's your return policy?", "answer": "<p>We accept returns within 30 days of delivery.</p>" } },
        { "type": "question", "settings": { "question": "Do you ship internationally?", "answer": "<p>Yes, we ship worldwide.</p>" } }
      ]
    }
  ]
}
{% endschema %}
