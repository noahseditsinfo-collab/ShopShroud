<section class="product page-width">
  <div class="product__gallery">
    {%- if product.media.size > 0 -%}
      <div class="product__main-image">
        <img id="ProductMainImage" src="{{ product.selected_or_first_available_variant.image | default: product.featured_image | image_url: width: 900 }}"
             alt="{{ product.featured_image.alt | escape }}" width="900" height="{{ 900 | divided_by: product.featured_image.aspect_ratio }}">
      </div>
      {%- if product.media.size > 1 -%}
        <div class="product__thumbnails">
          {%- for media in product.media -%}
            <button class="product__thumbnail" data-thumb data-image-url="{{ media.preview_image | image_url: width: 900 }}">
              <img src="{{ media.preview_image | image_url: width: 150 }}" alt="{{ media.alt | escape }}" width="150" height="{{ 150 | divided_by: media.preview_image.aspect_ratio }}">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>

  <div class="product__info">
    <h1 class="product__title">{{ product.title }}</h1>

    {%- if section.settings.show_social_proof -%}
      <div class="product__social-proof">
        <span class="product__rating">
          {%- for i in (1..5) -%}★{%- endfor -%}
          <span class="product__rating-count">({{ section.settings.review_count }} reviews)</span>
        </span>
        <span class="product__sold-count">{{ section.settings.sold_count }} sold in the last 30 days</span>
      </div>
    {%- endif -%}

    <div id="ProductPrice">{% render 'price', product: product %}</div>

    {%- if section.settings.show_bnpl -%}
      <p class="product__bnpl">Or 4 interest-free payments as low as {{ product.price | divided_by: 4 | money }} with <strong>Shop Pay</strong></p>
    {%- endif -%}

    <script type="application/json" id="ProductVariantsJson">{{ product.variants | json }}</script>
    <script>window.themeMoneyFormat = {{ shop.money_format | json }};</script>

    {% form 'product', product, id: 'product-form', class: 'product-form' %}
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <div class="product-form__option">
            <label>{{ option.name }}</label>
            <div class="product-form__swatches" data-option-index="{{ forloop.index0 }}">
              {%- for value in option.values -%}
                <button type="button" class="product-form__swatch{% if value == product.selected_or_first_available_variant.options[forloop.parentloop.index0] %} is-selected{% endif %}" data-option-value="{{ value | escape }}">{{ value }}</button>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endunless -%}

      <select name="id" class="product-form__variant-select" data-variant-select {% unless product.has_only_default_variant %}hidden{% endunless %}>
        {%- for variant in product.variants -%}
          <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %} {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>
            {{ variant.title }}{% unless variant.available %} - Sold out{% endunless %}
          </option>
        {%- endfor -%}
      </select>

      {%- if section.settings.show_fit_helper -%}
        <div class="product__fit-helper">
          <div class="product__fit-slider">
            <span>True to size</span>
            <span class="is-active">Relaxed</span>
            <span>Oversized</span>
          </div>
          <a href="{{ section.settings.size_guide_link }}" class="product__fit-link">Find your size</a>
        </div>
      {%- endif -%}

      <div class="product-form__quantity">
        <label for="Quantity">Qty</label>
        <input type="number" id="Quantity" name="quantity" value="1" min="1">
      </div>

      <button type="submit" id="AddToCartButton" class="button button--primary product-form__submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
        <span id="AddToCartText">{%- if product.selected_or_first_available_variant.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}</span>
      </button>

      {%- if section.settings.show_ship_date -%}
        <p class="product__ship-date">{{ section.settings.ship_date_text }}</p>
      {%- endif -%}

      {%- if section.settings.show_points -%}
        <p class="product__points">Earn {{ product.price | divided_by: 100 | ceil }} points with this purchase</p>
      {%- endif -%}
    {% endform %}

    {%- if section.settings.show_trust_badges -%}
      <div class="product__trust-badges">
        <span>{% render 'icon' with 'search' %} Built to Last</span>
        <span>{% render 'icon' with 'close' %} 30-Day Returns</span>
        <span>{% render 'icon' with 'account' %} {{ section.settings.review_count }}+ Reviews</span>
      </div>
    {%- endif -%}

    {%- if section.settings.show_review_quote and section.settings.review_quote != blank -%}
      <blockquote class="product__review-quote">
        "{{ section.settings.review_quote }}"
        <cite>— {{ section.settings.review_author }}</cite>
      </blockquote>
    {%- endif -%}

    <div class="product__description">{{ product.description }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Product information",
  "settings": [
    { "type": "checkbox", "id": "show_social_proof", "label": "Show rating and sold count", "default": true },
    { "type": "text", "id": "review_count", "label": "Review count", "default": "128" },
    { "type": "text", "id": "sold_count", "label": "Sold count (last 30 days)", "default": "42" },
    { "type": "checkbox", "id": "show_bnpl", "label": "Show buy-now-pay-later messaging", "default": true },
    { "type": "checkbox", "id": "show_fit_helper", "label": "Show fit slider / size helper", "default": true },
    { "type": "url", "id": "size_guide_link", "label": "Size guide link" },
    { "type": "checkbox", "id": "show_ship_date", "label": "Show ship date messaging", "default": true },
    { "type": "text", "id": "ship_date_text", "label": "Ship date text", "default": "In stock. Ships within 2-3 business days." },
    { "type": "checkbox", "id": "show_points", "label": "Show loyalty points callout", "default": true },
    { "type": "checkbox", "id": "show_trust_badges", "label": "Show trust badges row", "default": true },
    { "type": "checkbox", "id": "show_review_quote", "label": "Show pulled review quote", "default": true },
    { "type": "textarea", "id": "review_quote", "label": "Review quote", "default": "This piece reminds me daily of my faith. The quality is incredible and it's become part of my everyday rotation." },
    { "type": "text", "id": "review_author", "label": "Review author", "default": "Verified Buyer" }
  ]
}
{% endschema %}
