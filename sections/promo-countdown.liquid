<section class="promo-countdown" data-countdown data-end="{{ section.settings.end_date }}T{{ section.settings.end_time }}">
  <div class="page-width promo-countdown__inner">
    <div class="promo-countdown__text">
      {%- if section.settings.eyebrow != blank -%}<p class="promo-countdown__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="promo-countdown__heading">{{ section.settings.heading }}</h2>
    </div>

    <div class="promo-countdown__timer" data-countdown-timer>
      <div class="promo-countdown__unit"><span data-days>00</span><small>Days</small></div>
      <div class="promo-countdown__unit"><span data-hours>00</span><small>Hrs</small></div>
      <div class="promo-countdown__unit"><span data-minutes>00</span><small>Min</small></div>
      <div class="promo-countdown__unit"><span data-seconds>00</span><small>Sec</small></div>
    </div>

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="button button--primary">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Countdown banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Limited time" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sale ends soon" },
    { "type": "text", "id": "end_date", "label": "End date (YYYY-MM-DD)", "default": "2026-12-31" },
    { "type": "text", "id": "end_time", "label": "End time (HH:MM, 24hr)", "default": "23:59" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the Sale" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Countdown banner" }
  ]
}
{% endschema %}
