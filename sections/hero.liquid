<section class="hero" data-hero-carousel>
  <div class="hero__track">
    {%- for block in section.blocks -%}
      <div class="hero__slide{% if forloop.first %} is-active{% endif %}" style="--hero-bg: {{ block.settings.background_color }};" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <div class="hero__image">
            <img src="{{ block.settings.image | image_url: width: 1800 }}"
                 srcset="{{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1200 }} 1200w, {{ block.settings.image | image_url: width: 1800 }} 1800w"
                 sizes="100vw"
                 alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                 loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" width="1800" height="{{ 1800 | divided_by: block.settings.image.aspect_ratio }}">
          </div>
        {%- elsif forloop.first -%}
          <div class="hero__image">
            <img src="{{ 'hero-hoodie.png' | asset_url }}" alt="{{ block.settings.heading | escape }}" loading="eager">
          </div>
        {%- endif -%}

        <div class="hero__content page-width">
          {%- if block.settings.eyebrow != blank -%}<p class="hero__eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
          <h1 class="hero__heading">{{ block.settings.heading }}</h1>
          {%- if block.settings.subheading != blank -%}<p class="hero__subheading">{{ block.settings.subheading }}</p>{%- endif -%}
          <div class="hero__buttons">
            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_link }}" class="button button--primary">{{ block.settings.button_label }}</a>
            {%- endif -%}
            {%- if block.settings.button_label_2 != blank -%}
              <a href="{{ block.settings.button_link_2 }}" class="button button--secondary">{{ block.settings.button_label_2 }}</a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="hero__dots" data-hero-dots>
      {%- for block in section.blocks -%}
        <button type="button" class="hero__dot{% if forloop.first %} is-active{% endif %}" data-hero-dot data-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero carousel",
  "settings": [
    { "type": "range", "id": "autoplay_speed", "label": "Autoplay speed", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 6 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image" },
        { "type": "color", "id": "background_color", "label": "Fallback background color", "default": "#111111" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Jesus Based" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Clothing for the Journey" },
        { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Hope. Healing. Freedom." },
        { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop New Arrivals" },
        { "type": "url", "id": "button_link", "label": "Primary button link" },
        { "type": "text", "id": "button_label_2", "label": "Secondary button label", "default": "Our Mission" },
        { "type": "url", "id": "button_link_2", "label": "Secondary button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero carousel",
      "blocks": [
        { "type": "slide", "settings": { "eyebrow": "Jesus Based", "heading": "Clothing for the Journey", "subheading": "Hope. Healing. Freedom." } }
      ]
    }
  ]
}
{% endschema %}
