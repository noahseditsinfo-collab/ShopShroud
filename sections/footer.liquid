<footer class="site-footer">
  <div class="page-width site-footer__inner">

    <div class="site-footer__brand">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 240 }}" alt="{{ shop.name }}" width="140" loading="lazy">
      {%- else -%}
        <span class="site-footer__logo-text">{{ shop.name }}</span>
      {%- endif -%}
      <p>{{ section.settings.brand_text }}</p>
      <div class="site-footer__social">
        {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon' with 'instagram' %}</a>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" aria-label="TikTok">{% render 'icon' with 'tiktok' %}</a>{%- endif -%}
        {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" aria-label="Facebook">{% render 'icon' with 'facebook' %}</a>{%- endif -%}
        {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" aria-label="YouTube">{% render 'icon' with 'youtube' %}</a>{%- endif -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      <div class="site-footer__column" {{ block.shopify_attributes }}>
        <h3>{{ block.settings.heading }}</h3>
        <ul>
          {%- for link in block.settings.menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}

  </div>

  <div class="page-width site-footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
    {%- if section.settings.show_payment_icons -%}
      <ul class="site-footer__payment-icons">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Brand blurb",
      "default": "Independent streetwear made for the everyday. A portion of every order goes back to our community."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show accepted payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link_column", "settings": { "heading": "Shop" } },
      { "type": "link_column", "settings": { "heading": "Help" } },
      { "type": "link_column", "settings": { "heading": "Company" } }
    ]
  }
}
{% endschema %}
