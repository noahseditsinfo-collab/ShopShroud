<section class="about-page">
  <div class="about-page__hero">
    {%- if section.settings.eyebrow != blank -%}
      <p class="about-page__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1>{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="about-page__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <p class="about-page__mission">{{ section.settings.mission_statement }}</p>
    {%- if section.settings.hero_button_label != blank -%}
      <a href="{{ section.settings.hero_button_link | default: '/collections/all' }}" class="button button--primary">{{ section.settings.hero_button_label }}</a>
    {%- endif -%}
  </div>

  {%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
  {%- if stat_blocks.size > 0 -%}
    <div class="about-page__why">
      {%- if section.settings.why_heading != blank -%}
        <h2>{{ section.settings.why_heading }}</h2>
      {%- endif -%}
      <div class="about-page__stats">
        {%- for block in stat_blocks -%}
          <div class="about-page__stat" {{ block.shopify_attributes }}>
            <strong>{{ block.settings.number }}</strong>
            <span>{{ block.settings.label }}</span>
          </div>
        {%- endfor -%}
      </div>
      {%- if section.settings.stats_citation != blank -%}
        <p class="about-page__citation">{{ section.settings.stats_citation }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.settings.scripture_verse != blank -%}
    <div class="about-page__scripture">
      <p class="about-page__scripture-text">&ldquo;{{ section.settings.scripture_verse }}&rdquo;</p>
      {%- if section.settings.scripture_reference != blank -%}
        <p class="about-page__scripture-reference">{{ section.settings.scripture_reference }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.settings.story_body != blank -%}
    <div class="about-page__story">
      <h2>{{ section.settings.story_heading }}</h2>
      <div class="rte">{{ section.settings.story_body }}</div>
    </div>
  {%- endif -%}

  {%- if section.settings.founder_story_body != blank -%}
    <div class="about-page__story about-page__founder-story">
      <h2>{{ section.settings.founder_story_heading }}</h2>
      <div class="rte">{{ section.settings.founder_story_body }}</div>
      {%- if section.settings.vision_statement != blank -%}
        <p class="about-page__vision">{{ section.settings.vision_statement }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- assign team_blocks = section.blocks | where: 'type', 'team_member' -%}
  {%- if team_blocks.size > 0 -%}
    <div class="about-page__team">
      <h2>{{ section.settings.team_heading }}</h2>
      <div class="about-page__team-row">
        {%- for block in team_blocks -%}
          <div class="about-page__team-member" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 200 }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="100" height="100">
            {%- else -%}
              <div class="about-page__team-avatar" aria-hidden="true">{{ block.settings.name | slice: 0, 1 }}</div>
            {%- endif -%}
            <h3>{{ block.settings.name }}</h3>
            <p class="about-page__team-role">{{ block.settings.role }}</p>
            {%- if block.settings.quote != blank -%}
              <p class="about-page__team-quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.giving_body != blank -%}
    <div class="about-page__giving">
      <h2>{{ section.settings.giving_heading }}</h2>
      <p>{{ section.settings.giving_body }}</p>
    </div>
  {%- endif -%}
</section>

<style>
  .about-page__subheading {
    font-style: italic;
    opacity: 0.75;
    margin: -0.5rem 0 1rem;
  }
  .about-page__hero .button {
    margin-top: 1.5rem;
  }
  .about-page__why {
    text-align: center;
    padding: 3rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 3.5rem;
  }
  .about-page__why h2 {
    margin-bottom: 1.5rem;
  }
  .about-page__citation {
    font-size: 0.75rem;
    opacity: 0.55;
    margin-top: 1rem;
  }
  .about-page__scripture {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 3.5rem;
  }
  .about-page__scripture-text {
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.6;
  }
  .about-page__scripture-reference {
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.6;
    margin-top: 0.5rem;
  }
  .about-page__founder-story {
    margin-top: 3.5rem;
  }
  .about-page__vision {
    margin-top: 1.5rem;
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 1.1rem;
    text-align: center;
  }
  .about-page__team-member {
    text-align: center;
  }
  .about-page__team-avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: var(--color-bg-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 1.6rem;
    margin: 0 auto 0.75rem;
  }
  .about-page__team-role {
    opacity: 0.65;
    font-size: 0.85rem;
    margin-top: -0.4rem;
  }
  .about-page__team-quote {
    font-size: 0.85rem;
    font-style: italic;
    margin-top: 0.75rem;
    opacity: 0.85;
  }
</style>

{% schema %}
{
  "name": "About content",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Jesus Based" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "More Than A Movement" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "You were never meant to carry it alone." },
    { "type": "textarea", "id": "mission_statement", "label": "Mission statement", "default": "Shroud is a Christian apparel brand built to remind people they're covered — by grace, by faith, in whatever season they're walking through. Every piece is a conversation starter." },
    { "type": "text", "id": "hero_button_label", "label": "Hero button label", "default": "Shop the Collection" },
    { "type": "url", "id": "hero_button_link", "label": "Hero button link" },
    { "type": "text", "id": "why_heading", "label": "\"Why this matters\" heading", "default": "Why This Matters" },
    { "type": "textarea", "id": "stats_citation", "label": "Stats citation", "default": "Source: NAMI, \"Mental Health By the Numbers\" (2024 NSDUH data); NIMH." },
    { "type": "textarea", "id": "scripture_verse", "label": "Foundational scripture (verse text)" },
    { "type": "text", "id": "scripture_reference", "label": "Scripture reference (e.g. Mark 16:6)" },
    { "type": "text", "id": "story_heading", "label": "Meaning-of-the-name heading", "default": "Why We're Called Shroud" },
    { "type": "richtext", "id": "story_body", "label": "Meaning-of-the-name body" },
    { "type": "text", "id": "founder_story_heading", "label": "Founder story heading", "default": "Our Story" },
    { "type": "richtext", "id": "founder_story_body", "label": "Founder story body" },
    { "type": "text", "id": "vision_statement", "label": "Vision statement (short tagline)", "default": "Wear the message. Share the faith. Point people to Jesus." },
    { "type": "text", "id": "team_heading", "label": "Team heading", "default": "From the Team" },
    { "type": "text", "id": "giving_heading", "label": "Giving section heading", "default": "Our Mission" },
    { "type": "textarea", "id": "giving_body", "label": "Giving section body", "default": "A portion of every order supports faith-based recovery ministries — turning every order into real support for people who need it." }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "1 in 5" },
        { "type": "text", "id": "label", "label": "Label", "default": "U.S. adults experience a mental illness each year" }
      ]
    },
    {
      "type": "team_member",
      "name": "Team member",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo (optional)" },
        { "type": "text", "id": "name", "label": "Name", "default": "Team Member" },
        { "type": "text", "id": "role", "label": "Role", "default": "Owner" },
        { "type": "textarea", "id": "quote", "label": "Quote (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About content",
      "blocks": [
        { "type": "stat", "settings": { "number": "1 in 5", "label": "U.S. adults experience a mental illness each year" } },
        { "type": "stat", "settings": { "number": "1 in 3", "label": "Young adults ages 18–25 do — the highest of any age group" } },
        { "type": "stat", "settings": { "number": "1 in 2", "label": "Young adults with a mental illness go without treatment" } },
        { "type": "team_member", "settings": { "name": "Noah Seiler", "role": "Owner" } },
        { "type": "team_member", "settings": { "name": "Jim Piazza", "role": "Owner" } }
      ]
    }
  ]
}
{% endschema %}
